Процедура ПриЗаписи(Отказ)

    // Создаем документ
    ДокументОбъект = Документы.ИзменитьПоказанияПробега.СоздатьДокумент();

    ДокументОбъект.Дата = ТекущаяДата();

    // Указываем текущий автомобиль
    ДокументОбъект.Автомобиль = Ссылка; 
	
	ДокументОбъект.ПоказаниеОдометра = НачальныйПробег;

    // Записываем и проводим документ
    ДокументОбъект.Записать(
        РежимЗаписиДокумента.Проведение
    );

КонецПроцедуры