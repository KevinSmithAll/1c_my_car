Процедура ПередЗаписью(Отказ)

    // Проверяем, заполнен ли автомобиль
    Если Не ЗначениеЗаполнено(Автомобиль) Тогда
        Возврат;
    КонецЕсли;

    // Проверяем, есть ли уже начальные параметры
    НаборЗаписей = РегистрыСведений.НачальныеПараметрыТО.СоздатьНаборЗаписей();

    НаборЗаписей.Отбор.Автомобиль.Установить(Автомобиль);
    НаборЗаписей.Отбор.Работа.Установить(Ссылка);
    НаборЗаписей.Прочитать();

    // Если запись уже есть, ничего не меняем
    Если НаборЗаписей.Количество() > 0 Тогда
        Возврат;
    КонецЕсли;

    // Получаем текущий пробег автомобиля
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   ПробегАвтомобиляСрезПоследних.Пробег КАК Пробег
    |ИЗ
    |   РегистрСведений.ПробегАвтомобиля.СрезПоследних(
    |       ,
    |       Автомобиль = &Автомобиль
    |   ) КАК ПробегАвтомобиляСрезПоследних";

    Запрос.УстановитьПараметр("Автомобиль", Автомобиль);

    Выборка = Запрос.Выполнить().Выбрать();

    НачальныйПробег = 0;

    Если Выборка.Следующий() Тогда
        НачальныйПробег = Выборка.Пробег;
    КонецЕсли;

    // Создаём начальные параметры ТО
    Запись = РегистрыСведений.НачальныеПараметрыТО.СоздатьМенеджерЗаписи();

    Запись.Автомобиль = Автомобиль;
    Запись.Работа = Ссылка;
    Запись.НачальныйПробег = НачальныйПробег;
    Запись.ДатаНачала = ТекущаяДата();

    Запись.Записать();

КонецПроцедуры