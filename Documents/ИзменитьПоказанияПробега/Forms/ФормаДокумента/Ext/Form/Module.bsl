	Объект.КрайнееПоказаниеОдометра = ДанныеИзТаблиц.Пробег;
	Объект.НаДату = ДанныеИзТаблиц.НаДату;
	// Вставить содержимое обработчика.
КонецПроцедуры

&НаСервере
Функция ПолучитьПробег()
	Данные = ОбщийМодуль.ПолучитьАктуальныйПробег(Объект.Автомобиль);
	Возврат Данные;
КонецФункции
