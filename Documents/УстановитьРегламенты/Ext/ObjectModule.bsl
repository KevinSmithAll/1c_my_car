
Процедура ОбработкаПроведения(Отказ, Режим)
	Движения.УстановкаРегламентов.Записывать = Истина;
	Для Каждого ТекСтрокаТЧРегламентов Из ТЧРегламентов Цикл
		Движение = Движения.УстановкаРегламентов.Добавить();
		Движение.Период = Дата;
		Движение.Автомобиль = Автомобиль;
		Движение.РегламентнаяОперация = ТекСтрокаТЧРегламентов.РегламентнаяОперация;
		Движение.Пробег = ТекСтрокаТЧРегламентов.ПоПробегу;
		Движение.Периодизация = ТекСтрокаТЧРегламентов.ПоВремени;
	КонецЦикла;
КонецПроцедуры
