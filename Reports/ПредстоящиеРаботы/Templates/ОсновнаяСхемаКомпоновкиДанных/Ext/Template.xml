		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    План.Автомобиль КАК Автомобиль,
    План.НазваниеРаботы КАК НазваниеРаботы,
    ЗапланированныеТО.ЭтоРазоваяРабота КАК РазоваяРабота,

    ВЫБОР
        КОГДА ЗапланированныеТО.ЭтоРазоваяРабота
            ТОГДА ЗапланированныеТО.НаКакомПробеге
                - ЕСТЬNULL(
                    ПробегАвтомобиля.Пробег,
                    Автомобили.НачальныйПробег
                )
        ИНАЧЕ
            ЕСТЬNULL(
                СделанныеТО.НаПробеге,
                Автомобили.НачальныйПробег
            )
            + ЗапланированныеТО.ИнтервалКМ
            - ЕСТЬNULL(
                ПробегАвтомобиля.Пробег,
                Автомобили.НачальныйПробег
            )
    КОНЕЦ КАК ОсталосьКМ,

    ВЫБОР
        КОГДА ЗапланированныеТО.ЭтоРазоваяРабота
            ТОГДА ДОБАВИТЬКДАТЕ(
                Автомобили.ДатаНачалаЭксплуатации,
                МЕСЯЦ,
                План.ЧерезСколькоМесяцев
            )
        ИНАЧЕ
            ВЫБОР
                КОГДА ЗапланированныеТО.ИнтервалВремени &gt; 0
                    ТОГДА ДОБАВИТЬКДАТЕ(
                        ЕСТЬNULL(
                            СделанныеТО.Период,
                            Автомобили.ДатаНачалаЭксплуатации
                        ),
                        МЕСЯЦ,
                        ЗапланированныеТО.ИнтервалВремени
                    )
                ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
            КОНЕЦ
    КОНЕЦ КАК ДатаСледующегоТО,

    СделанныеТО.Период КАК ДатаПоследнегоВыполнения

ИЗ
    РегистрСведений.ЗапланированныеТО
        КАК ЗапланированныеТО

    ВНУТРЕННЕЕ СОЕДИНЕНИЕ
        Документ.ПланированиеРаботПоАвто КАК План
    ПО ЗапланированныеТО.ЗапланированнаяРабота = План.Ссылка

    ВНУТРЕННЕЕ СОЕДИНЕНИЕ
        Справочник.Автомобили КАК Автомобили
    ПО План.Автомобиль = Автомобили.Ссылка

    ЛЕВОЕ СОЕДИНЕНИЕ
        РегистрСведений.ПробегАвтомобиля.СрезПоследних(
            ,
            Автомобиль = &amp;Автомобиль
        ) КАК ПробегАвтомобиля
    ПО План.Автомобиль = ПробегАвтомобиля.Автомобиль

    ЛЕВОЕ СОЕДИНЕНИЕ
        РегистрСведений.СделанныеТО.СрезПоследних(
            ,
            Автомобиль = &amp;Автомобиль
        ) КАК СделанныеТО
    ПО ЗапланированныеТО.Автомобиль = СделанныеТО.Автомобиль
        И ЗапланированныеТО.ЗапланированнаяРабота =
            СделанныеТО.Работа

ГДЕ
    План.Автомобиль = &amp;Автомобиль

    И (
        НЕ ЗапланированныеТО.ЭтоРазоваяРабота
        ИЛИ СделанныеТО.Работа ЕСТЬ NULL
    )

    И (
        // По времени: срок уже наступил
        // или наступит в течение следующих 6 месяцев
        (
            (
                ЗапланированныеТО.ЭтоРазоваяРабота
                И План.ЧерезСколькоМесяцев &gt; 0
            )
            ИЛИ
            (
                НЕ ЗапланированныеТО.ЭтоРазоваяРабота
                И ЗапланированныеТО.ИнтервалВремени &gt; 0
            )
        )
        И
        (
            ВЫБОР
                КОГДА ЗапланированныеТО.ЭтоРазоваяРабота
                    ТОГДА ДОБАВИТЬКДАТЕ(
                        Автомобили.ДатаНачалаЭксплуатации,
                        МЕСЯЦ,
                        План.ЧерезСколькоМесяцев
                    )
                ИНАЧЕ ДОБАВИТЬКДАТЕ(
                    ЕСТЬNULL(
                        СделанныеТО.Период,
                        Автомобили.ДатаНачалаЭксплуатации
                    ),
                    МЕСЯЦ,
                    ЗапланированныеТО.ИнтервалВремени
                )
            КОНЕЦ &lt;= ДОБАВИТЬКДАТЕ(
                &amp;ТекущаяДата,
                МЕСЯЦ,
                &amp;Месяцев
            )
        )

        ИЛИ

        // По пробегу: осталось 15 000 км или меньше
        (
            (
                ЗапланированныеТО.ЭтоРазоваяРабота
                И ЗапланированныеТО.НаКакомПробеге &gt; 0
            )
            ИЛИ
            (
                НЕ ЗапланированныеТО.ЭтоРазоваяРабота
                И ЗапланированныеТО.ИнтервалКМ &gt; 0
            )
        )
        И
        (
            ВЫБОР
                КОГДА ЗапланированныеТО.ЭтоРазоваяРабота
                    ТОГДА ЗапланированныеТО.НаКакомПробеге
                ИНАЧЕ
                    ЕСТЬNULL(
                        СделанныеТО.НаПробеге,
                        Автомобили.НачальныйПробег
                    )
                    + ЗапланированныеТО.ИнтервалКМ
            КОНЕЦ
            - ЕСТЬNULL(
                ПробегАвтомобиля.Пробег,
                Автомобили.НачальныйПробег
            ) &lt;= &amp;Километража
        )
    )</query>
