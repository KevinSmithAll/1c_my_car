
&НаКлиенте
Процедура Загрузить(Команда)

    ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
    ПараметрыДиалога.МножественныйВыбор = Ложь;
    ПараметрыДиалога.Заголовок = "Выберите JSON-файл";
    ПараметрыДиалога.Фильтр = "JSON-файлы (*.json)|*.json";

    Оповещение = Новый ОписаниеОповещения(
        "ПослеВыбораJSON",
        ЭтаФорма);

    НачатьПомещениеФайлаНаСервер(
        Оповещение,
        ,
        ,
        ,
        ПараметрыДиалога,
        УникальныйИдентификатор);

КонецПроцедуры


&НаКлиенте
Процедура ПослеВыбораJSON(
    ОписаниеФайла,
    ДополнительныеПараметры) Экспорт

    Если ОписаниеФайла = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Если ОписаниеФайла.ПомещениеФайлаОтменено Тогда
        Возврат;
    КонецЕсли;

    Попытка
        Результат = ПрочитатьJSONНаСервере(
            ОписаниеФайла.Адрес);

        Сообщить(Результат);

    Исключение
        Сообщить(
            "Ошибка импорта: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры


&НаСервереБезКонтекста
Функция ПрочитатьJSONНаСервере(АдресФайла)

    ДвоичныеДанные = ПолучитьИзВременногоХранилища(
        АдресФайла);

    Если ДвоичныеДанные = Неопределено Тогда
        ВызватьИсключение
            "Не удалось получить файл из временного хранилища.";
    КонецЕсли;

    ВременныйФайл = ПолучитьИмяВременногоФайла("json");

    ДвоичныеДанные.Записать(ВременныйФайл);

    ЧтениеТекстаФайла = Новый ЧтениеТекста(
        ВременныйФайл,
        КодировкаТекста.UTF8);

    ТекстJSON = ЧтениеТекстаФайла.Прочитать();
    ЧтениеТекстаФайла.Закрыть();

    ЧтениеJSON = Новый ЧтениеJSON;

    Попытка
        ЧтениеJSON.УстановитьСтроку(ТекстJSON);
        ДанныеJSON = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
    Исключение
        ВызватьИсключение
            "Ошибка разбора JSON: " + ОписаниеОшибки();
    КонецПопытки;

    Если ТипЗнч(ДанныеJSON) <> Тип("Массив") Тогда
        ВызватьИсключение
            "Корневой элемент JSON должен быть массивом.";
    КонецЕсли;

    Возврат ИмпортироватьКаталог(ДанныеJSON);

КонецФункции


&НаСервереБезКонтекста
Функция ИмпортироватьКаталог(ДанныеJSON)

    СозданоДеталей = 0;
    НайденоДеталей = 0;
    ДобавленоБрендов = 0;
    ОбновленоЦен = 0;
    ПропущеноДеталей = 0;

    Предупреждения = Новый Массив;

    // Сначала начинаем транзакцию.
    НачатьТранзакцию();

    Попытка

        Для Каждого ДанныеДетали Из ДанныеJSON Цикл

            Если ТипЗнч(ДанныеДетали) <> Тип("Структура") Тогда

                ПропущеноДеталей =
                    ПропущеноДеталей + 1;

                Предупреждения.Добавить(
                    "Пропущена запись: ожидался объект JSON.");

                Продолжить;

            КонецЕсли;

            Наименование = "";
            АвтомобильИмя = "";
            КомментарийJSON = "";

            ДанныеДетали.Свойство(
                "Наименование", Наименование);

            ДанныеДетали.Свойство(
                "Автомобиль", АвтомобильИмя);

            ДанныеДетали.Свойство(
                "Комментарий", КомментарийJSON);

            // Проверяем обязательные поля.
            Если Не ЗначениеЗаполнено(Наименование)
                Или Не ЗначениеЗаполнено(АвтомобильИмя) Тогда

                ПропущеноДеталей =
                    ПропущеноДеталей + 1;

                Предупреждения.Добавить(
                    "Пропущена деталь без наименования "
                    + "или автомобиля.");

                Продолжить;

            КонецЕсли;

            // Ищем автомобиль по точному наименованию.
            АвтомобильСсылка =
                Справочники.Автомобили.НайтиПоНаименованию(
                    АвтомобильИмя, Истина);

            Если АвтомобильСсылка.Пустая() Тогда

                ПропущеноДеталей =
                    ПропущеноДеталей + 1;

                Предупреждения.Добавить(
                    "Автомобиль не найден: "
                    + АвтомобильИмя);

                Продолжить;

            КонецЕсли;

            // Ищем карточку по наименованию и автомобилю.
            Запрос = Новый Запрос;

            Запрос.Текст =
                "ВЫБРАТЬ ПЕРВЫЕ 1
                |   Детали.Ссылка КАК Ссылка
                |ИЗ
                |   Справочник.НоменклатураДеталей КАК Детали
                |ГДЕ
                |   Детали.Наименование = &Наименование
                |   И Детали.Автомобиль = &Автомобиль";

            Запрос.УстановитьПараметр(
                "Наименование", Наименование);

            Запрос.УстановитьПараметр(
                "Автомобиль", АвтомобильСсылка);

            Выборка = Запрос.Выполнить().Выбрать();

            Если Выборка.Следующий() Тогда

                ОбъектДетали =
                    Выборка.Ссылка.ПолучитьОбъект();

                НоваяКарточка = Ложь;

                НайденоДеталей =
                    НайденоДеталей + 1;

            Иначе

                ОбъектДетали =
                    Справочники.НоменклатураДеталей
                    .СоздатьЭлемент();

                ОбъектДетали.Наименование =
                    Наименование;

                ОбъектДетали.Автомобиль =
                    АвтомобильСсылка;

                НоваяКарточка = Истина;

                СозданоДеталей =
                    СозданоДеталей + 1;

            КонецЕсли;

            // Заполняем комментарий новой карточки
            // или существующей карточки с пустым комментарием.
            Если НоваяКарточка
                Или Не ЗначениеЗаполнено(
                    ОбъектДетали.Комментарий) Тогда

                Если ЗначениеЗаполнено(КомментарийJSON) Тогда
                    ОбъектДетали.Комментарий =
                        КомментарийJSON;
                КонецЕсли;

            КонецЕсли;

            // Получаем бренды из JSON.
            БрендыJSON = Новый Массив;

            ДанныеДетали.Свойство(
                "Бренды", БрендыJSON);

            Если ТипЗнч(БрендыJSON) <> Тип("Массив") Тогда

                Предупреждения.Добавить(
                    "У детали отсутствует массив Бренды: "
                    + Наименование);

                БрендыJSON = Новый Массив;

            КонецЕсли;

            Для Каждого БрендJSON Из БрендыJSON Цикл

                Если ТипЗнч(БрендJSON)
                    <> Тип("Структура") Тогда

                    Предупреждения.Добавить(
                        "Пропущена некорректная строка бренда: "
                        + Наименование);

                    Продолжить;

                КонецЕсли;

                Фирма = "";
                Артикул = "";
                Страна = "";
                Цена = Неопределено;

                ЦенаУказана =
                    БрендJSON.Свойство(
                        "ПримернаяЦена", Цена);

                БрендJSON.Свойство("Фирма", Фирма);
                БрендJSON.Свойство("Артикул", Артикул);
                БрендJSON.Свойство("Страна", Страна);

                // Фирма и артикул обязательны.
                Если Не ЗначениеЗаполнено(Фирма)
                    Или Не ЗначениеЗаполнено(Артикул) Тогда

                    Предупреждения.Добавить(
                        "Пропущен бренд без фирмы или артикула: "
                        + Наименование);

                    Продолжить;

                КонецЕсли;

                // Ищем строку по фирме и артикулу.
                СтрокаНайдена = Ложь;

                Для Каждого СтрокаБренда
                    Из ОбъектДетали.Бренды Цикл

                    Если СтрокаБренда.Фирма = Фирма
                        И СтрокаБренда.Артикул = Артикул Тогда

                        СтрокаНайдена = Истина;

                        // Пустая цена не затирает существующую.
                        Если ЦенаУказана
                            И Цена <> Неопределено
                            И Цена <> Null Тогда

                            Если СтрокаБренда.ПримернаяЦена
                                <> Цена Тогда

                                СтрокаБренда.ПримернаяЦена =
                                    Цена;

                                ОбновленоЦен =
                                    ОбновленоЦен + 1;

                            КонецЕсли;

                        КонецЕсли;

                        Прервать;

                    КонецЕсли;

                КонецЦикла;

                // Если строки нет, добавляем её.
                Если Не СтрокаНайдена Тогда

                    НоваяСтрока =
                        ОбъектДетали.Бренды.Добавить();

                    НоваяСтрока.Страна = Страна;
                    НоваяСтрока.Фирма = Фирма;
                    НоваяСтрока.Артикул = Артикул;

                    Если ЦенаУказана
                        И Цена <> Неопределено
                        И Цена <> Null Тогда

                        НоваяСтрока.ПримернаяЦена =
                            Цена;

                    КонецЕсли;

                    ДобавленоБрендов =
                        ДобавленоБрендов + 1;

                КонецЕсли;

            КонецЦикла;

            // Записываем карточку и её табличную часть.
            ОбъектДетали.Записать();

        КонецЦикла;

        // Все записи прошли успешно.
        ЗафиксироватьТранзакцию();

    Исключение

        // При ошибке отменяем изменения транзакции.
        ОтменитьТранзакцию();

        ВызватьИсключение
            "Импорт отменён. Изменения не сохранены. "
            + ОписаниеОшибки();

    КонецПопытки;

    // Формируем отчёт.
    Отчет = "Импорт завершён." + Символы.ПС
        + "Всего записей JSON: "
        + Строка(ДанныеJSON.Количество()) + Символы.ПС
        + "Создано деталей: "
        + Строка(СозданоДеталей) + Символы.ПС
        + "Найдено существующих деталей: "
        + Строка(НайденоДеталей) + Символы.ПС
        + "Добавлено строк брендов: "
        + Строка(ДобавленоБрендов) + Символы.ПС
        + "Обновлено цен: "
        + Строка(ОбновленоЦен) + Символы.ПС
        + "Пропущено деталей: "
        + Строка(ПропущеноДеталей);

    Для Каждого Предупреждение Из Предупреждения Цикл

        Отчет = Отчет + Символы.ПС
            + Предупреждение;

    КонецЦикла;

    Возврат Отчет;

КонецФункции
